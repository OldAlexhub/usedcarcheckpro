PUBLIC_BASE_URL=https://proveh.server.oldalexhub.com

POSTGRES_DB=proveh
POSTGRES_USER=proveh
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
# For a Nexus-managed database, set the complete async SQLAlchemy URL instead.
# DATABASE_URL=postgresql+asyncpg://proveh:password@localhost:5432/proveh

ENVIRONMENT=production
LOG_LEVEL=info
AUTO_CREATE_SCHEMA=false
PROVEH_MAX_UPLOAD_BYTES=10485760
NHTSA_TIMEOUT_SECONDS=12
VIN_CACHE_DAYS=30
ANALYTICS_RETENTION_DAYS=365
DATASET_RETENTION_DAYS=1825

ADMIN_USERNAME=mohamedgad
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-unique-random-string-of-at-least-32-characters
ADMIN_SESSION_HOURS=12
CORS_ORIGINS=
